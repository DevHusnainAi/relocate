{
  "name": "relocate",
  "version": "1.0.0",
  "description": "Autonomous healer for broken Playwright locators: ZeroDOM finds the moved element, IBM Bob subagents patch and verify in parallel.",
  "scripts": {
    "test": "node --test relocate.test.ts",
    "heal": "node relocate.ts heal",
    "reset": "git checkout -- 'tests/*.spec.ts' && rm -rf .relocate relocate-proof",
    "red": "playwright test",
    "build:spa": "vite build demo-spa"
  },
  "keywords": [
    "playwright",
    "e2e",
    "flaky-tests",
    "self-healing",
    "ibm-bob",
    "zerodom"
  ],
  "type": "module",
  "dependencies": {
    "@playwright/test": "^1.63.0",
    "@vexralabs/zerodom": "^0.0.9"
  },
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevHusnainAi/relocate.git"
  },
  "homepage": "https://github.com/DevHusnainAi/relocate#readme",
  "bugs": {
    "url": "https://github.com/DevHusnainAi/relocate/issues"
  },
  "author": "DevHusnainAi",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1"
  }
}
